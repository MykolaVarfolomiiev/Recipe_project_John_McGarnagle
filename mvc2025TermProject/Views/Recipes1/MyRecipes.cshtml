@model PaginatedList<mvc2025TermProject.Models.ViewModels.RecipeViewModel>

@{
    ViewData["Title"] = "My Recipes";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>@ViewData["Title"]</h1>

<a asp-action="StepOne" class="btn btn-success">Create New</a>

<div class="list-group mt-4">

    @foreach (var item in Model)
    {
        <div class="list-group-item list-group-item-action d-flex align-items-center shadow-sm mb-2 div-color">

            <!-- Image -->
            <td>
            @if (item.Images != null && item.Images.Any(i => i.IsApproved == true))
            {
                @foreach (var img in item.Images.Where(i => i.IsApproved == true))
                {
                    @if (img.IsPrimary == true)
                    {
                            <img src="@Url.Action("Serve", "Images", new { id = img.ImageID })"
                             alt="@img.AltText"
                             class="recipeImg img-fluid rounded shadow"
                             style="width: 100px; height: 100px; object-fit: cover;" />
                    }
                }
            }
            else
            {
                <img src="~/img/image-not-avaliable01.jpg"
                     alt="Image not available"
                     class="img-fluid small-image rounded shadow"
                         style="max-width: 100px; max-height: 100px; object-fit: cover;" />
            }
            </td>
            <!-- Info & Actions -->
            <div class="flex-grow-1 d-flex justify-content-between align-items-center ms-3">

                <!-- Recipe Info -->
                <div>
                    <h5 class="mb-1">
                        @if (item.PreparationTime == null)
                        {
                            <a asp-action="StepTwo" asp-route-recipeId="@item.RecipeID" class="text-decoration-none">
                                @item.RecipeName
                            </a>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@item.RecipeID" class="text-decoration-none">
                                @item.RecipeName
                            </a>
                        }
                    </h5>

                    <p class="mb-1">
                        <strong>Category:</strong>
                        @(item.Category.ApprovedCategoryName ?? item.Category.PendingCategoryName + " (pending)")
                    </p>

                    <p class="mb-0">
                        <strong>Created:</strong>
                        @(item.Created?.ToShortDateString() ?? "—")
                    </p>

                    <p class="mb-0">
                        <strong>Status:</strong>
                        @(item.Status)
                    </p>

                </div>

                <!-- Buttons -->
                <div class="text-end">

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <a asp-action="Edit" asp-route-id="@item.RecipeID" class="btn btn-primary btn-sm me-1">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.RecipeID" class="btn btn-danger btn-sm me-1">Delete</a>
                    }

                    <a asp-action="Details" asp-route-id="@item.RecipeID" class="btn btn-secondary btn-sm me-1">Details</a>

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <a asp-controller="Images" asp-action="Create" asp-route-recipeId="@item.RecipeID"
                           class="btn btn-outline-secondary btn-sm accent-color"
                           style="color: black !important;">
                            <i class="bi bi-image"></i> Add Images
                        </a>
                    }
                </div>

            </div>
        </div>
    }

</div>

<!-- Pagination -->
<div class="mt-4">
    <nav aria-label="Recipe pagination">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="MyRecipes"
                   asp-route-pageNumber="@(Model.PageIndex - 1)"
                   tabindex="-1">Previous</a>
            </li>

            <li class="page-item active">
                <span class="page-link">
                    Page @Model.PageIndex of @Model.TotalPages
                </span>
            </li>

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="MyRecipes"
                   asp-route-pageNumber="@(Model.PageIndex + 1)">Next</a>
            </li>

        </ul>
    </nav>
</div>
