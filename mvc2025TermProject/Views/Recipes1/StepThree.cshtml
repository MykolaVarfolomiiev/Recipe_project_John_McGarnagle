@model mvc2025TermProject.Models.ViewModels.StepThree
@{
    ViewData["Title"] = "Create Recipe - StepThree";
}

<h2 class="text-center mt-4">@Model.RecipeName</h2>

<h4 class="text-center" style="color: dimgray">Category: @Model.CategoryName</h4>

<h5 class="text-center" style="color: dimgray">Status: @Model.Status</h5>
@* Current Date *@
<div class="d-flex justify-content-end">
    <div class="div-color p-2">
        Created on: @DateTime.Now.ToString("MMM dd, yyyy")
    </div>
</div>

<div class="row my-2">
    <!-- Main image -->
    <div class="col-md-6 p-0">
        <img src="~/img/image-not-avaliable01.jpg" alt="img not available"
             class="img-fluid w-100 h-100 rounded border"
             style="object-fit: cover;" />
    </div>

    <!-- Ingredients table -->
    <div class="col-md-6">
        <h4>Ingredients</h4>
        <table class="table table-bordered border rounded">
            <thead>
                <tr style="background-color: gray">
                    <th>Ingredient</th>
                    <th>Amount</th>
                    <th>Measurement</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Ingredients)
                {
                    <tr>
                        <td>@item.IngredientName</td>
                        <td>@item.Amount</td>
                        <td>@item.MeasurementType</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<form asp-action="StepThree" method="post">
    <input type="hidden" asp-for="RecipeID" />

    <div class="mb-3">
        <label asp-for="Instruction"></label>
        <textarea asp-for="Instruction" class="form-control" rows="6"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Tips"></label>
        <textarea asp-for="Tips" class="form-control"></textarea>
    </div>

    <div class="row">
        <div class="col-md-4">
            <label asp-for="PreparationTime"></label>
            <input asp-for="PreparationTime" class="form-control" type="number" placeholder="Prep. time in minutes" />

            <span asp-validation-for="PreparationTime" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="CookingTime"></label>
            <input asp-for="CookingTime" class="form-control" type="number" placeholder="Cook. time in minutes" />

            <span asp-validation-for="CookingTime" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="CookingTemperature"></label>
            <input asp-for="CookingTemperature" class="form-control" type="number" placeholder="Temperature in Fahrenheit" />

            <span asp-validation-for="CookingTemperature" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-3 mb-3">
        <label asp-for="NumberOfServings"></label>
        <input asp-for="NumberOfServings" class="form-control" type="number" />

        <span asp-validation-for="NumberOfServings" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SpecialEquipment"></label>
        <textarea asp-for="SpecialEquipment" class="form-control"></textarea>
        <span asp-validation-for="SpecialEquipment" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="YoutubeLinks"></label>
        <textarea asp-for="YoutubeLinks" class="form-control" rows="4"></textarea>
        <span asp-validation-for="YoutubeLinks" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NutritionalInfo"></label>
        <textarea asp-for="NutritionalInfo" class="form-control" rows="4"></textarea>
        <span asp-validation-for="NutritionalInfo" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary mt-4">Save Recipe</button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}