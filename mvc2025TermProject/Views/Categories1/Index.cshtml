@model IEnumerable<mvc2025TermProject.Models.Category>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ApprovedCategoryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApprovedCategoryDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PendingCategoryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PendingCategoryDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedBy)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ApprovedCategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ApprovedCategoryDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PendingCategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PendingCategoryDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy.EmailAddress)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CategoryID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CategoryID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CategoryID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
