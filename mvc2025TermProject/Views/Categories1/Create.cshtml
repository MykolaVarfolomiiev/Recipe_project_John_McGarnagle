            </div>
            <div class="form-group">
                <label asp-for="ApprovedCategoryDescription" class="control-label"></label>
                <input asp-for="ApprovedCategoryDescription" class="form-control" />
                <span asp-validation-for="ApprovedCategoryDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PendingCategoryName" class="control-label"></label>
                <input asp-for="PendingCategoryName" class="form-control" />
                <span asp-validation-for="PendingCategoryName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PendingCategoryDescription" class="control-label"></label>
                <input asp-for="PendingCategoryDescription" class="form-control" />
                <span asp-validation-for="PendingCategoryDescription" class="text-danger"></span>
            </div>
