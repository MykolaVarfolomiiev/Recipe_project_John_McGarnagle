@{
    ViewData["Title"] = "John McGarnagle | Home";
}

<!-- About Me Section-->
<div class="d-flex justify-content-between flex-wrap my-4">
    <div class="row align-items-center">

        <!-- Image column -->
        <div class="col-md-6 text-center text-md-end">
            <img src="~/img/john.jpg" alt="John McGarnagle" class="img-fluid rounded" style="max-width: 100%; height: auto;">
        </div>

        <!-- Text column -->
        <div class="col-md-6 d-flex">
            <div class="card shadow-lg border-0 flex-fill py-5">
                <div class="card-body">
                    <h2 class="card-title mb-3">About John McGarnagle</h2>
                    <p class="mb-3">
                        In 2020, John McGarnagle launched his channel as a way to cope with mental health struggles
                        and find connection during a time of isolation. Cooking reminded him of his childhood and the joy
                        he felt in the kitchen with his family, and he wanted to share that same sense of comfort and togetherness with others.
                    </p>
                    <p class="mb-0">
                        What makes his content unique is his focus on viewer-submitted family recipes. From treasured classics
                        to lesser-known dishes, John brings these recipes to life in his kitchen, giving them a spotlight and
                        sharing the stories behind them. His videos are not just about cooking—they’re about honouring memories,
                        keeping traditions alive, and reminding viewers that every dish has a story worth telling.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Feature Recipe Section -->  
<h4 class="accent-color p-1 homeTextBlocks mb-4">Featured Recipes</h4>
<br />

<div class="d-flex justify-content-between flex-wrap">
    <!-- Left card -->
    <div class="div-color p-4 homeRecipeDivs">
        <img src="~/img/Sundubu-Jjigae_800.jpg" alt="Feature Recipe"
             class="img-fluid mx-auto d-block recipeImg" style="max-height: 500px;">

        <h4 class="my-3 p-1 accent-color homeTextBlocks recipeName">Sundubu Jjigae</h4>

        <div class="d-flex justify-content-between align-items-center">
            <h4 class="p-1 m-0 accent-color homeTextBlocks">Korean</h4>
            <h4 class="p-1 m-0 accent-color homeTextBlocks">30 min</h4>
        </div>
    </div>

    <!-- Right card -->
    <div class="div-color p-4 homeRecipeDivs">
        <img src="~/img/ramen.jpg" alt="Feature Recipe"
             class="img-fluid mx-auto d-block recipeImg" style="max-height: 500px;">

        <h4 class="my-3 p-1 accent-color homeTextBlocks recipeName">Ramen</h4>

        <div class="d-flex justify-content-between align-items-center">
            <h4 class="p-1 m-0 accent-color homeTextBlocks">Japanese</h4>
            <h4 class="p-1 m-0 accent-color homeTextBlocks">25 min</h4>
        </div>
    </div>
</div>
