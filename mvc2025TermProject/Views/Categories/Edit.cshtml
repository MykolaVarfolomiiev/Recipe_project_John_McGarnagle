@model mvc2025TermProject.Models.ViewModels.CategoryEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Category</h4>
    <hr />
</div>

<div class="row">
    <div class="col-md-6">
        <!-- CURRENT APPROVED DETAILS -->
        <div>
            <h4>Current Approved Details</h4>
            <hr />
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.ApprovedName)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.ApprovedName)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.ApprovedDescription)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.ApprovedDescription)
                </dd>
            </dl>
        </div>
    </div>

    <div class="col-md-6">
        <!-- UPDATE FORM -->
        <h4>Update Details</h4>
        <hr />
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CategoryID" />

            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<hr />

<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
