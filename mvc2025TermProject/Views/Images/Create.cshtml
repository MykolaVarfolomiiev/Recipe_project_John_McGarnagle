@model mvc2025TermProject.Models.Image

@{
    ViewData["Title"] = "Add Images";
}

<h1>@ViewData["Title"]</h1>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-4 mb-3">

        <!-- SINGLE CORRECT FORM -->
        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">   <!-- REQUIRED -->

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Recipe dropdown -->
            <div class="form-group">
                <label asp-for="RecipeID" class="control-label"></label>
                <select asp-for="RecipeID" class="form-control" asp-items="ViewBag.RecipeID">
                    <option disabled selected>-- Select Recipe --</option>
                </select>
            </div>

            <!-- File upload -->
            <div class="mt-3">
                <label>Select File:</label>
                <input type="file" name="postedFile" class="form-control" />
            </div>
            @if (ViewBag.Message != null) {
            <div class="alert alert-danger m-2">@ViewBag.Message</div>
            }
            <!-- Description -->
            <div class="mt-3">
                <label>Description:</label>
                <input type="text" name="description" class="form-control" />
            </div>

            <!-- Alt Text -->
            <div class="mt-3">
                <label>Alt Text:</label>
                <input type="text" name="altText" class="form-control" />
            </div>

            <div class="mt-3 form-check">
                <input type="checkbox" class="form-check-input" id="IsPrimary" name="isPrimary" value="true" @(Model?.IsPrimary == true ? "checked" : "") />
                <label class="form-check-label" for="IsPrimary">Set as Primary Image</label>
            </div>

            <button type="submit" class="btn btn-primary mt-3">Upload</button>

        </form>
    </div>
</div>

@{
    var currentImages =
        ViewBag.CurrentImages as List<mvc2025TermProject.Models.Image>
        ?? new List<mvc2025TermProject.Models.Image>();
}

@if (Model.RecipeID.HasValue == true)
{
    <hr />

    <div class="mt-4">

        <h4>
            Images
            <small class="text-muted">
                (@currentImages.Count / 7)
            </small>
        </h4>

        @if (currentImages.Any())
        {
            <div class="d-flex flex-wrap gap-3 mt-3">

                @foreach (var img in currentImages)
                {
                    <div class="card"
                         style="width: 160px;">

                        <img src="@Url.Action("Serve", "Images", new { id = img.ImageID })"
                             alt="@img.AltText"
                             class="card-img-top"
                             style="height: 120px; object-fit: cover;" />

                        <div class="card-body p-2">

                            @if (img.IsPrimary == true)
                            {
                                <div class="mb-2">
                                    <span class="badge bg-success">
                                        Primary
                                    </span>
                                </div>
                            }
                            else
                            {
                                <form asp-action="SetPrimary"
                                      method="post"
                                      class="mb-2">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@img.ImageID" />

                                    <button type="submit"
                                            class="btn btn-primary btn-sm w-100">
                                        Set Primary
                                    </button>

                                </form>
                            }

                            <form asp-action="Delete"
                                  method="post"
                                  onsubmit="return confirm('Delete this image?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@img.ImageID" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm w-100">
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <p class="text-muted mt-2">
                No images have been added yet.
            </p>
        }
    </div>
}

<div>
    <a asp-controller="Recipes1" asp-action="MyRecipes">Back to My Recipes</a>
</div