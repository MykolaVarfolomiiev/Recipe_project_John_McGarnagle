@model mvc2025TermProject.Models.Recipe

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Recipe</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RecipeName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RecipeName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedBy.EmailAddress)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedBy.UserName)
        </dd>
        @* <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt> *@
        @* <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd> *@
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Instruction)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Instruction)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PreparationTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PreparationTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CookingTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CookingTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NumberOfServings)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NumberOfServings)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Category)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Category.ApprovedCategoryName ?? model.Category.PendingCategoryName + (" pending"))
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.RecipeID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
