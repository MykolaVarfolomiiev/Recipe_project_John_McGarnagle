@using Microsoft.AspNetCore.Identity
@using mvc2025TermProject.Data
@inject UserManager<IdentityUser> UserManager
@inject ApplicationDbContext _context

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/mvc2025TermProject.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="main-color">

        <div class="d-flex align-items-center justify-content-between main-color1 p-3">
            <!-- LOGO -->
            <a class="d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/largeLogo.png" alt="Logo" height="150" class="me-2" />
            </a>

            <!-- NAV + DATE -->
            <div class="d-flex flex-column align-items-end pt-4">
                <nav class="navbar bg main-color navbar-expand-sm navbar-toggleable-sm navbar-light mb-1">
                    <div class="container-fluid p-0">

                        <!-- Burger -->
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <!-- Nav Links -->
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end main-color">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link text-dark accent-color mx-1" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark accent-color mx-1" asp-area="" asp-controller="Recipes1" asp-action="Index">Browse Recipes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark accent-color mx-1" asp-area="" asp-controller="Ingredients" asp-action="Index">Ingredients</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark accent-color mx-1" asp-area="" asp-controller="Categories" asp-action="Index">Categories</a>
                                </li>
                                @* <li class="nav-item">
                                    <a class="nav-link text-dark accent-color mx-1" asp-area="" asp-controller="Recipes1" asp-action="StepOne">Create</a>
                                </li> *@
                                @{
                                    bool showMyRecipes = false;

                                    if (User.Identity.IsAuthenticated)
                                    {
                                        var identityUserId = UserManager.GetUserId(User);

                                        showMyRecipes = _context.RecipeUsers
                                        .Any(r => r.IdentityUserId == identityUserId);
                                    }
                                }

                                @if (showMyRecipes){
                                @* <li class="nav-item">
                                    <a class="nav-link text-dark accent-color mx-1" asp-area="" asp-controller="Images" asp-action="Create">Add Images</a>
                                </li> *@

                                <li class="nav-item">
                                    <a class="nav-link text-dark accent-color mx-1" asp-area="" asp-controller="Recipes1" asp-action="MyRecipes">My Recipes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark accent-color mx-1" asp-area="" asp-controller="Recipes1" asp-action="StepOne">Create</a>
                                </li>
                                }
                            </ul>

                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </nav>

                <!-- DATE UNDER LINKS -->
                <div class="text-end m-1">
                    @DateTime.Now.ToString("MMM dd, yyyy")
                </div>
            </div>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-black main-color text-center">
        <div class="container">
            &copy; 2026 - Mykola Varfolomiiev -
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
